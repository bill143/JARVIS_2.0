{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.oneillcontractors.com/schemas/goat_agents_eval.case.v1.json",
  "title": "NEXUS GOAT Agent Eval Case",
  "description": "Validation rulebook for a single eval case in the goat_agents_eval_30 dataset (and successors). Every record uploaded to nexus_memory.eval_cases must satisfy this schema.",
  "type": "object",
  "required": [
    "id",
    "pillar",
    "role",
    "level",
    "input",
    "expected_output",
    "rubric",
    "failure_modes"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable external identifier. Convention: P{pillar}-{NN} (e.g., P1-01).",
      "pattern": "^P[1-6]-[0-9]{2,3}$"
    },
    "pillar": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6,
      "description": "1=System Prompts, 2=RAG, 3=Tool Equipping, 4=Few-Shot Examples, 5=Memory Persistence, 6=Evaluation Loops"
    },
    "pillar_name": {
      "type": "string",
      "enum": [
        "System Prompts",
        "RAG",
        "Tool Equipping",
        "Few-Shot Examples",
        "Memory Persistence",
        "Evaluation Loops"
      ]
    },
    "role": {
      "type": "string",
      "minLength": 2,
      "description": "Free-text role label (e.g., 'CEO', 'Project Manager (Operations)', 'Worker (Docs)')."
    },
    "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6,
      "description": "1=CEO, 2=Executive, 3=PM, 4=PE, 5=Superintendent, 6=Worker"
    },
    "input": {
      "type": "object",
      "required": ["task"],
      "properties": {
        "task": { "type": "string", "minLength": 1 },
        "context": { "type": "object" },
        "rag_context": {
          "type": "object",
          "description": "Optional. Required for RAG (pillar=2) cases.",
          "properties": {
            "retrieved_passages": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["source", "text"],
                "properties": {
                  "source": { "type": "string" },
                  "text":   { "type": "string" }
                }
              }
            },
            "instructions": { "type": "string" }
          }
        },
        "memory": {
          "type": "object",
          "description": "Optional. Required for Memory Persistence (pillar=5) cases."
        }
      }
    },
    "expected_output": {
      "type": "object",
      "required": ["must_include"],
      "properties": {
        "must_include": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "must_not_include": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "rubric": {
      "type": "object",
      "required": ["scoring_scale", "criteria"],
      "properties": {
        "scoring_scale": {
          "type": "string",
          "description": "Human-readable scale, e.g., '0-2 per criterion'."
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "checks", "weight"],
            "additionalProperties": false,
            "properties": {
              "name":   { "type": "string", "minLength": 1 },
              "checks": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "weight": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 10
              }
            }
          }
        }
      }
    },
    "failure_modes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "notes": {
      "type": ["string", "null"]
    }
  },
  "allOf": [
    {
      "description": "Pillar number must match pillar_name when both are provided.",
      "if": {
        "properties": { "pillar": { "const": 1 } },
        "required": ["pillar", "pillar_name"]
      },
      "then": { "properties": { "pillar_name": { "const": "System Prompts" } } }
    },
    {
      "if": {
        "properties": { "pillar": { "const": 2 } },
        "required": ["pillar", "pillar_name"]
      },
      "then": { "properties": { "pillar_name": { "const": "RAG" } } }
    },
    {
      "if": {
        "properties": { "pillar": { "const": 3 } },
        "required": ["pillar", "pillar_name"]
      },
      "then": { "properties": { "pillar_name": { "const": "Tool Equipping" } } }
    },
    {
      "if": {
        "properties": { "pillar": { "const": 4 } },
        "required": ["pillar", "pillar_name"]
      },
      "then": { "properties": { "pillar_name": { "const": "Few-Shot Examples" } } }
    },
    {
      "if": {
        "properties": { "pillar": { "const": 5 } },
        "required": ["pillar", "pillar_name"]
      },
      "then": { "properties": { "pillar_name": { "const": "Memory Persistence" } } }
    },
    {
      "if": {
        "properties": { "pillar": { "const": 6 } },
        "required": ["pillar", "pillar_name"]
      },
      "then": { "properties": { "pillar_name": { "const": "Evaluation Loops" } } }
    }
  ]
}
