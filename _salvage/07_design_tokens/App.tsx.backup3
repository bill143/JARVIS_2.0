import React, { useState, useEffect, useRef } from 'react';
import { 
  Mic, Volume2, VolumeX, Brain, MessageSquare, 
  Settings, Maximize2, Minimize2, Camera, MapPin,
  Mail, Music, Youtube, Search, FileText, Download, Send,
  Wifi, WifiOff, Cpu, Activity, Globe, Calendar, Cloud, Video,
  Image, File, MessageCircle, Command, Sparkles, Cog, 
  Play, Pause, SkipBack, SkipForward, MicOff,
  User, Bell, CheckCircle, X, Plus, Trash2, RefreshCw,
  Calendar as CalendarIcon, Bitcoin, TrendingUp, Droplets, Wind, ChevronRight, Bot
} from 'lucide-react';
import { getModelResponse } from './services/chatService';
import { mapFilesToTracks, formatDuration, type MusicTrack } from './services/musicService';
import { fetchNews as fetchNewsData, type NewsItem } from './services/newsService';
import {
  NEWS_CATEGORY_OPTIONS,
  readSettings,
  SETTINGS_STORAGE_KEY,
  type AppSettings,
  type NewsCategory,
} from './services/settingsService';
import { formatUptime, type SystemStatus } from './services/systemService';
import { speakText, stopSpeech, type SpeakResult } from './services/speechService';
import { EMPTY_WEATHER, fetchWeather as fetchWeatherData, type WeatherData } from './services/weatherService';

// Types
interface Message {
  id: string;
  role: 'user' | 'assistant';
  content: string;
  timestamp: Date;
  type?: 'text' | 'voice' | 'system';
}

interface Feature {
  id: string;
  name: string;
  description: string;
  icon: React.ReactNode;
  category: string;
  active: boolean;
  demo?: boolean;
}

interface Task {
  id: string;
  title: string;
  completed: boolean;
  priority: 'low' | 'medium' | 'high';
  dueDate?: string;
}


declare global {
  interface Window {
    electronAPI?: {
      getSystemStats?: () => Promise<{ cpu: number; memory: number; disk?: number }>;
    };
  }
}

interface BatteryManager extends EventTarget {
  level: number;
  charging: boolean;
}

