// Components
const VoiceWave = ({ active }: { active: boolean }) => (
  <div className={`sound-wave flex items-center gap-1 ${active ? 'opacity-100' : 'opacity-30'}`}>
    {[...Array(12)].map((_, i) => (
      <span 
        key={i}
        className="w-1 bg-gradient-to-t from-cyan-400 to-cyan-300 rounded-full"
        style={{ 
          animationDelay: `${i * 0.08}s`,
          height: active ? `${Math.random() * 24 + 8}px` : '8px',
          animation: active ? 'soundWave 0.5s ease-in-out infinite' : 'none'
        }}
      />
    ))}
  </div>
);

const SystemMonitor = ({ status }: { status: SystemStatus }) => (
  <div className="glass-panel rounded-xl p-4 space-y-4">
    <div className="flex items-center justify-between">
      <h3 className="font-orbitron text-cyan-400 text-sm font-semibold flex items-center gap-2">
        <Cpu className="w-4 h-4" />
        SYSTEM STATUS
      </h3>
      <span className="text-xs text-gray-500">{status.uptime}</span>
    </div>
    <div className="grid grid-cols-2 gap-4">
      <div className="space-y-2">
        <div className="flex justify-between text-xs">
          <span className="text-gray-400">CPU</span>
          <span className="text-cyan-400 font-mono">{status.cpu === null ? 'N/A' : `${status.cpu}%`}</span>
        </div>
        <div className="h-2 bg-gray-800 rounded-full overflow-hidden">
          <div 
            className="h-full bg-gradient-to-r from-cyan-500 to-cyan-300 transition-all duration-700 rounded-full"
            style={{ width: `${status.cpu ?? 0}%` }}
          />
        </div>
      </div>
      <div className="space-y-2">
        <div className="flex justify-between text-xs">
          <span className="text-gray-400">Memory</span>
          <span className="text-purple-400 font-mono">{status.memory === null ? 'N/A' : `${status.memory}%`}</span>
        </div>
        <div className="h-2 bg-gray-800 rounded-full overflow-hidden">
          <div 
            className="h-full bg-gradient-to-r from-purple-500 to-cyan-400 transition-all duration-700 rounded-full"
            style={{ width: `${status.memory ?? 0}%` }}
          />
        </div>
      </div>
      <div className="space-y-2">
        <div className="flex justify-between text-xs">
          <span className="text-gray-400">Disk</span>
          <span className="text-green-400 font-mono">{status.disk}%</span>
        </div>
        <div className="h-2 bg-gray-800 rounded-full overflow-hidden">
          <div 
            className="h-full bg-gradient-to-r from-green-500 to-emerald-400 transition-all duration-700 rounded-full"
            style={{ width: `${status.disk}%` }}
          />
        </div>
      </div>
      <div className="space-y-2">
        <div className="flex justify-between text-xs">
          <span className="text-gray-400">Battery</span>
          <span className="text-yellow-400 font-mono">{status.battery === null ? 'N/A' : `${status.battery}%`}</span>
        </div>
        <div className="h-2 bg-gray-800 rounded-full overflow-hidden">
          <div 
            className="h-full bg-gradient-to-r from-yellow-500 to-orange-400 transition-all duration-700 rounded-full"
            style={{ width: `${status.battery ?? 0}%` }}
          />
        </div>
      </div>
    </div>
    {status.limitationMessage && (
      <p className="text-[11px] text-amber-400/90 leading-relaxed">{status.limitationMessage}</p>
    )}
    <div className="flex items-center justify-between pt-3 border-t border-gray-800">
      <div className="flex items-center gap-3">
        {status.network === 'online' ? (
          <Wifi className="w-4 h-4 text-green-400 animate-pulse" />
        ) : (
          <WifiOff className="w-4 h-4 text-red-400" />
        )}
        <span className="text-xs text-gray-400 capitalize">{status.network}</span>
      </div>
      <div className="flex items-center gap-2">
        <Brain className="w-4 h-4 text-cyan-400" />
        <span className="text-xs text-gray-400">{status.ai}</span>
      </div>
      <div className="flex items-center gap-2">
        <Mic className="w-4 h-4 text-green-400" />
        <span className="text-xs text-gray-400 capitalize">{status.voice}</span>
      </div>
    </div>
  </div>
);

const ChatMessage = ({ message }: { message: Message }) => (
  <div className={`flex ${message.role === 'user' ? 'justify-end' : 'justify-start'} animate-fadeIn`}>
    <div className={`max-w-[85%] rounded-2xl px-4 py-3 ${
      message.role === 'user' 
        ? 'bg-gradient-to-r from-cyan-500/20 to-purple-500/20 border border-cyan-500/30' 
        : message.type === 'voice'
        ? 'bg-green-500/10 border border-green-500/30'
        : 'glass-panel'
    }`}>
      <div className="flex items-start gap-3">
        {message.role === 'assistant' && (
          <div className="w-8 h-8 rounded-full bg-gradient-to-br from-cyan-400 to-cyan-300 flex items-center justify-center flex-shrink-0">
            <Brain className="w-4 h-4 text-slate-900" />
          </div>
        )}
        <div className="flex-1">
          <p className="text-sm text-white leading-relaxed">{message.content}</p>
          <div className="flex items-center justify-end gap-2 mt-2">
            {message.type === 'voice' && (
              <span className="text-xs text-green-400 flex items-center gap-1">
                <Mic className="w-3 h-3" /> Voice
              </span>
            )}
            <span className="text-xs text-gray-500">
              {message.timestamp.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}
            </span>
          </div>
        </div>
        {message.role === 'user' && (
          <div className="w-8 h-8 rounded-full bg-gradient-to-br from-purple-500 to-pink-500 flex items-center justify-center flex-shrink-0">
            <User className="w-4 h-4 text-white" />
          </div>
        )}
      </div>
    </div>
  </div>
);

const FeatureCard = ({ feature, onClick, expanded }: { feature: Feature; onClick: () => void; expanded?: boolean }) => (
  <button
    onClick={onClick}
    className={`glass-panel rounded-xl p-4 hover:border-cyan-500/50 transition-all group text-left w-full ${expanded ? 'border-cyan-500/50 bg-cyan-500/5' : ''}`}
  >
    <div className="flex items-start gap-3">
      <div className="p-2.5 rounded-xl bg-cyan-500/10 text-cyan-400 group-hover:bg-cyan-500/20 transition-all group-hover:scale-110">
        {feature.icon}
      </div>
      <div className="flex-1 min-w-0">
        <div className="flex items-center justify-between">
          <h4 className="font-semibold text-sm text-white group-hover:text-cyan-400 transition-colors">
            {feature.name}
          </h4>
          <ChevronRight className={`w-4 h-4 text-gray-500 transition-transform ${expanded ? 'rotate-90' : ''}`} />
        </div>
        <p className="text-xs text-gray-400 mt-1.5 line-clamp-2">
          {feature.description}
        </p>
        {expanded && feature.demo && (
          <div className="mt-3 pt-3 border-t border-gray-700">
            <span className="text-xs text-green-400 flex items-center gap-1">
              <Sparkles className="w-3 h-3" /> Demo Available
            </span>
          </div>
        )}
      </div>
    </div>
  </button>
);

const WeatherPanel = ({
  weather,
  loading,
  error,
  onRefresh,
}: {
  weather: WeatherData;
  loading: boolean;
  error: string | null;
  onRefresh: () => void;
}) => (
  <div className="glass-panel rounded-xl p-5 space-y-4">
    <div className="flex items-center justify-between">
      <div>
        <h3 className="font-orbitron text-cyan-400 text-sm font-semibold">WEATHER</h3>
        <p className="text-xs text-gray-500 mt-1">{weather.location}</p>
      </div>
      <div className="flex items-center gap-3">
        <button onClick={onRefresh} className="text-gray-400 hover:text-cyan-300 transition-colors" title="Refresh weather">
          <RefreshCw className={`w-4 h-4 ${loading ? 'animate-spin' : ''}`} />
        </button>
        <div className="text-5xl">
          {weather.condition.toLowerCase().includes('clear') ? '☀️' : weather.condition.toLowerCase().includes('cloud') ? '☁️' : '🌤️'}
        </div>
      </div>
    </div>
    <div className="text-center">
      <div className="font-orbitron text-5xl font-bold text-white">{loading ? '--' : `${weather.temp}°`}</div>
      <p className="text-gray-400 text-sm mt-1">{loading ? 'Loading...' : weather.condition}</p>
    </div>
    <div className="grid grid-cols-2 gap-4 pt-3 border-t border-gray-700">
      <div className="flex items-center gap-2 text-gray-400">
        <Droplets className="w-4 h-4 text-blue-400" />
        <span className="text-xs">{weather.humidity}%</span>
      </div>
      <div className="flex items-center gap-2 text-gray-400">
        <Wind className="w-4 h-4 text-cyan-400" />
        <span className="text-xs">{weather.wind} mph</span>
      </div>
    </div>
    {error && <p className="text-xs text-red-400">{error}</p>}
  </div>
);

const NewsPanel = ({
  news,
  loading,
  error,
  category,
  onCategoryChange,
  onRefresh,
}: {
  news: NewsItem[];
  loading: boolean;
  error: string | null;
  category: NewsCategory;
  onCategoryChange: (category: NewsCategory) => void;
  onRefresh: () => void;
}) => (
  <div className="glass-panel rounded-xl p-4 space-y-3">
    <div className="flex items-center justify-between">
      <h3 className="font-orbitron text-cyan-400 text-sm font-semibold">NEWS</h3>
      <div className="flex items-center gap-2">
        <select
          value={category}
          onChange={(e) => onCategoryChange(e.target.value as NewsCategory)}
          className="bg-slate-900 border border-gray-700 rounded-lg px-2 py-1 text-xs text-cyan-300"
        >
          {NEWS_CATEGORY_OPTIONS.map((option) => (
            <option key={option.value} value={option.value}>
              {option.label}
            </option>
          ))}
        </select>
        <button onClick={onRefresh} className="text-xs text-cyan-400 hover:text-cyan-300 transition-colors">
          Refresh
        </button>
      </div>
    </div>
    <div className="space-y-3">
      {loading && <p className="text-xs text-gray-500">Loading headlines...</p>}
      {error && <p className="text-xs text-red-400">{error}</p>}
      {!loading && !error && news.length === 0 && <p className="text-xs text-gray-500">No headlines found.</p>}
      {news.map((item) => (
        <div key={item.id} className="group cursor-pointer p-2 -mx-2 rounded-lg hover:bg-white/5 transition-colors">
          <h4 className="text-sm text-gray-300 group-hover:text-white transition-colors line-clamp-2">
            {item.title}
          </h4>
          <div className="flex items-center gap-2 mt-1.5">
            <span className="text-xs text-cyan-400">{item.source}</span>
            <span className="text-xs text-gray-600">•</span>
            <span className="text-xs text-gray-500">{item.time}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
);

const MusicPlayer = ({
  tracks,
  currentTrack,
  isPlaying,
  currentTime,
  onPlayPause,
  onNext,
  onPrev,
  onLoadFiles,
  error,
}: {
  tracks: MusicTrack[];
  currentTrack: number;
  isPlaying: boolean;
  currentTime: number;
  onPlayPause: () => void;
  onNext: () => void;
  onPrev: () => void;
  onLoadFiles: () => void;
  error: string | null;
}) => (
  <div className="glass-panel rounded-xl p-4 space-y-4">
    <div className="flex items-center justify-between">
      <h3 className="font-orbitron text-cyan-400 text-sm font-semibold">MUSIC</h3>
      <div className="flex items-center gap-2">
        <span className="text-xs text-gray-500">{tracks.length} tracks</span>
        <button onClick={onLoadFiles} className="text-xs text-cyan-400 hover:text-cyan-300 transition-colors">
          Load Files
        </button>
      </div>
    </div>
    <div className="flex items-center gap-4 p-3 bg-slate-900/50 rounded-lg">
      <div className="w-14 h-14 rounded-lg bg-gradient-to-br from-cyan-500/30 to-purple-500/30 flex items-center justify-center text-2xl">
        {tracks[currentTrack]?.cover || '🎵'}
      </div>
      <div className="flex-1 min-w-0">
        <h4 className="text-white text-sm font-medium truncate">{tracks[currentTrack]?.title}</h4>
        <p className="text-gray-400 text-xs truncate">{tracks[currentTrack]?.artist}</p>
      </div>
    </div>
    <div className="flex items-center justify-center gap-4">
      <button onClick={onPrev} className="p-2 text-gray-400 hover:text-white transition-colors">
        <SkipBack className="w-5 h-5" />
      </button>
      <button 
        onClick={onPlayPause} 
        className="p-3 rounded-full bg-gradient-to-r from-cyan-500 to-cyan-400 hover:from-cyan-400 hover:to-cyan-300 transition-all"
      >
        {isPlaying ? <Pause className="w-5 h-5 text-slate-900" /> : <Play className="w-5 h-5 text-slate-900 ml-0.5" />}
      </button>
      <button onClick={onNext} className="p-2 text-gray-400 hover:text-white transition-colors">
        <SkipForward className="w-5 h-5" />
      </button>
    </div>
    <div className="space-y-1">
      <div className="h-1 bg-gray-800 rounded-full overflow-hidden">
        <div
          className="h-full bg-gradient-to-r from-cyan-500 to-purple-500 rounded-full transition-all"
          style={{
            width:
              tracks[currentTrack]?.durationSeconds > 0
                ? `${Math.min(100, (currentTime / tracks[currentTrack].durationSeconds) * 100)}%`
                : '0%',
          }}
        />
      </div>
      <div className="flex justify-between text-xs text-gray-500">
        <span>{formatDuration(currentTime)}</span>
        <span>{tracks[currentTrack]?.duration}</span>
      </div>
    </div>
    {error && <p className="text-xs text-red-400">{error}</p>}
  </div>
);

const TodoPanel = ({ tasks, onToggle, onDelete, onAdd }: {
  tasks: Task[];
  onToggle: (id: string) => void;
  onDelete: (id: string) => void;
  onAdd: () => void;
}) => (
  <div className="glass-panel rounded-xl p-4 space-y-3">
    <div className="flex items-center justify-between">
      <h3 className="font-orbitron text-cyan-400 text-sm font-semibold">TASKS</h3>
      <button onClick={onAdd} className="p-1 rounded-lg bg-cyan-500/20 text-cyan-400 hover:bg-cyan-500/30 transition-colors">
        <Plus className="w-4 h-4" />
      </button>
    </div>
    <div className="space-y-2 max-h-48 overflow-y-auto">
      {tasks.map((task) => (
        <div key={task.id} className="flex items-center gap-3 group p-2 rounded-lg hover:bg-white/5 transition-colors">
          <button
            onClick={() => onToggle(task.id)}
            className={`w-5 h-5 rounded-md border-2 flex items-center justify-center transition-all ${
              task.completed 
                ? 'bg-green-500 border-green-500' 
                : task.priority === 'high'
                ? 'border-red-500'
                : task.priority === 'medium'
                ? 'border-yellow-500'
                : 'border-gray-600 hover:border-cyan-500'
            }`}
          >
            {task.completed && <CheckCircle className="w-3 h-3 text-white" />}
          </button>
          <span className={`flex-1 text-sm ${task.completed ? 'text-gray-500 line-through' : 'text-gray-200'}`}>
            {task.title}
          </span>
          <button onClick={() => onDelete(task.id)} className="opacity-0 group-hover:opacity-100 text-gray-500 hover:text-red-400 transition-all">
            <Trash2 className="w-4 h-4" />
          </button>
        </div>
      ))}
    </div>
  </div>
);

const SettingsPanel = ({
  onClose,
  settings,
  onUpdate,
}: {
  onClose: () => void;
  settings: AppSettings;
  onUpdate: (update: Partial<AppSettings>) => void;
}) => {
  return (
    <div className="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center p-4">
      <div className="glass-panel rounded-2xl p-6 w-full max-w-lg max-h-[80vh] overflow-y-auto">
        <div className="flex items-center justify-between mb-6">
          <h2 className="font-orbitron text-xl text-white">Settings</h2>
          <button onClick={onClose} className="text-gray-400 hover:text-white transition-colors">
            <X className="w-6 h-6" />
          </button>
        </div>
        
        <div className="space-y-6">
          <div className="space-y-4">
            <h3 className="text-sm font-semibold text-cyan-400">AI Settings</h3>
            <div className="space-y-3">
              <div className="flex items-center justify-between">
                <span className="text-gray-300 text-sm">Default AI Model</span>
                <select 
                  value={settings.aiModel}
                  onChange={(e) => onUpdate({ aiModel: e.target.value })}
                  className="bg-slate-800 border border-gray-700 rounded-lg px-3 py-2 text-white text-sm"
                >
                  {AI_MODELS.map(m => (
                    <option key={m.id} value={m.id}>{m.name}</option>
                  ))}
                </select>
              </div>
              <div className="space-y-2">
                <label className="text-xs text-gray-400">OpenAI API Key</label>
                <input
                  type="password"
                  value={settings.openAiApiKey}
                  onChange={(e) => onUpdate({ openAiApiKey: e.target.value })}
                  className="w-full bg-slate-800 border border-gray-700 rounded-lg px-3 py-2 text-white text-sm"
                  placeholder="sk-..."
                />
              </div>
              <div className="space-y-2">
                <label className="text-xs text-gray-400">Anthropic API Key</label>
                <input
                  type="password"
                  value={settings.anthropicApiKey}
                  onChange={(e) => onUpdate({ anthropicApiKey: e.target.value })}
                  className="w-full bg-slate-800 border border-gray-700 rounded-lg px-3 py-2 text-white text-sm"
                  placeholder="sk-ant-..."
                />
              </div>
              <div className="space-y-2">
                <label className="text-xs text-gray-400">Gemini API Key</label>
                <input
                  type="password"
                  value={settings.geminiApiKey}
                  onChange={(e) => onUpdate({ geminiApiKey: e.target.value })}
                  className="w-full bg-slate-800 border border-gray-700 rounded-lg px-3 py-2 text-white text-sm"
                  placeholder="AIza..."
                />
              </div>
              <div className="space-y-2">
                <label className="text-xs text-gray-400">Mistral API Key</label>
                <input
                  type="password"
                  value={settings.mistralApiKey}
                  onChange={(e) => onUpdate({ mistralApiKey: e.target.value })}
                  className="w-full bg-slate-800 border border-gray-700 rounded-lg px-3 py-2 text-white text-sm"
                  placeholder="mistral-key"
                />
              </div>
              <div className="space-y-2">
                <label className="text-xs text-gray-400">Ollama Base URL</label>
                <input
                  type="text"
                  value={settings.ollamaBaseUrl}
                  onChange={(e) => onUpdate({ ollamaBaseUrl: e.target.value })}
                  className="w-full bg-slate-800 border border-gray-700 rounded-lg px-3 py-2 text-white text-sm"
                  placeholder="http://localhost:11434"
                />
              </div>
            </div>
          </div>

          <div className="space-y-4">
            <h3 className="text-sm font-semibold text-cyan-400">Voice Settings</h3>
            <div className="space-y-3">
              <div className="flex items-center justify-between">
                <span className="text-gray-300 text-sm">Voice Recognition</span>
                <button 
                  onClick={() => onUpdate({ voiceEnabled: !settings.voiceEnabled })}
                  className={`w-12 h-6 rounded-full transition-colors ${settings.voiceEnabled ? 'bg-cyan-500' : 'bg-gray-700'}`}
                >
                  <div className={`w-5 h-5 rounded-full bg-white transition-transform ${settings.voiceEnabled ? 'translate-x-6' : 'translate-x-0.5'}`} />
                </button>
              </div>
              <div className="flex items-center justify-between">
                <span className="text-gray-300 text-sm">Sound Effects</span>
                <button 
                  onClick={() => onUpdate({ soundEffects: !settings.soundEffects })}
                  className={`w-12 h-6 rounded-full transition-colors ${settings.soundEffects ? 'bg-cyan-500' : 'bg-gray-700'}`}
                >
                  <div className={`w-5 h-5 rounded-full bg-white transition-transform ${settings.soundEffects ? 'translate-x-6' : 'translate-x-0.5'}`} />
                </button>
              </div>
              <div className="space-y-2">
                <label className="text-xs text-gray-400">Speech Provider</label>
                <select
                  value={settings.ttsProvider}
                  onChange={(e) => onUpdate({ ttsProvider: e.target.value as AppSettings['ttsProvider'] })}
                  className="w-full bg-slate-800 border border-gray-700 rounded-lg px-3 py-2 text-white text-sm"
                >
                  <option value="auto">Auto (ElevenLabs then Browser)</option>
                  <option value="browser">Browser Speech</option>
                  <option value="elevenlabs">ElevenLabs</option>
                </select>
              </div>
              <div className="space-y-2">
                <label className="text-xs text-gray-400">ElevenLabs API Key (optional)</label>
                <input
                  type="password"
                  value={settings.elevenLabsApiKey}
                  onChange={(e) => onUpdate({ elevenLabsApiKey: e.target.value })}
                  className="w-full bg-slate-800 border border-gray-700 rounded-lg px-3 py-2 text-white text-sm"
                  placeholder="xi-api-key"
                />
              </div>
              <div className="space-y-2">
                <label className="text-xs text-gray-400">ElevenLabs Voice ID</label>
                <input
                  type="text"
                  value={settings.elevenLabsVoiceId}
                  onChange={(e) => onUpdate({ elevenLabsVoiceId: e.target.value })}
                  className="w-full bg-slate-800 border border-gray-700 rounded-lg px-3 py-2 text-white text-sm"
                  placeholder="EXAVITQu4vr4xnSDxMaL"
                />
              </div>
              <div className="space-y-2">
                <label className="text-xs text-gray-400">Preferred Browser Voice (optional)</label>
                <input
                  type="text"
                  value={settings.preferredBrowserVoice}
                  onChange={(e) => onUpdate({ preferredBrowserVoice: e.target.value })}
                  className="w-full bg-slate-800 border border-gray-700 rounded-lg px-3 py-2 text-white text-sm"
                  placeholder="e.g. Microsoft Aria Online"
                />
              </div>
            </div>
          </div>

          <div className="space-y-4">
            <h3 className="text-sm font-semibold text-cyan-400">Integrations</h3>
            <div className="space-y-3">
              <div className="space-y-2">
                <label className="text-xs text-gray-400">OpenWeather API Key</label>
                <input
                  type="password"
                  value={settings.weatherApiKey}
                  onChange={(e) => onUpdate({ weatherApiKey: e.target.value })}
                  className="w-full bg-slate-800 border border-gray-700 rounded-lg px-3 py-2 text-white text-sm"
                  placeholder="OpenWeatherMap key"
                />
              </div>
              <div className="space-y-2">
                <label className="text-xs text-gray-400">Weather Location (optional)</label>
                <input
                  type="text"
                  value={settings.weatherLocation}
                  onChange={(e) => onUpdate({ weatherLocation: e.target.value })}
                  className="w-full bg-slate-800 border border-gray-700 rounded-lg px-3 py-2 text-white text-sm"
                  placeholder="City, State"
                />
              </div>
              <div className="space-y-2">
                <label className="text-xs text-gray-400">GNews API Key</label>
                <input
                  type="password"
                  value={settings.newsApiKey}
                  onChange={(e) => onUpdate({ newsApiKey: e.target.value })}
                  className="w-full bg-slate-800 border border-gray-700 rounded-lg px-3 py-2 text-white text-sm"
                  placeholder="GNews key"
                />
              </div>
              <div className="space-y-2">
                <label className="text-xs text-gray-400">Default News Category</label>
                <select
                  value={settings.newsCategory}
                  onChange={(e) => onUpdate({ newsCategory: e.target.value as NewsCategory })}
                  className="w-full bg-slate-800 border border-gray-700 rounded-lg px-3 py-2 text-white text-sm"
                >
                  {NEWS_CATEGORY_OPTIONS.map((option) => (
                    <option key={option.value} value={option.value}>
                      {option.label}
                    </option>
                  ))}
                </select>
              </div>
            </div>
          </div>

          <div className="space-y-4">
            <h3 className="text-sm font-semibold text-cyan-400">System Settings</h3>
            <div className="space-y-3">
              <div className="flex items-center justify-between">
                <span className="text-gray-300 text-sm">Notifications</span>
                <button 
                  onClick={() => onUpdate({ notifications: !settings.notifications })}
                  className={`w-12 h-6 rounded-full transition-colors ${settings.notifications ? 'bg-cyan-500' : 'bg-gray-700'}`}
                >
                  <div className={`w-5 h-5 rounded-full bg-white transition-transform ${settings.notifications ? 'translate-x-6' : 'translate-x-0.5'}`} />
                </button>
              </div>
              <div className="flex items-center justify-between">
                <span className="text-gray-300 text-sm">Minimize to Tray</span>
                <button 
                  onClick={() => onUpdate({ minimizeToTray: !settings.minimizeToTray })}
                  className={`w-12 h-6 rounded-full transition-colors ${settings.minimizeToTray ? 'bg-cyan-500' : 'bg-gray-700'}`}
                >
                  <div className={`w-5 h-5 rounded-full bg-white transition-transform ${settings.minimizeToTray ? 'translate-x-6' : 'translate-x-0.5'}`} />
                </button>
              </div>
              <div className="flex items-center justify-between">
                <span className="text-gray-300 text-sm">Auto Start</span>
                <button 
                  onClick={() => onUpdate({ autoStart: !settings.autoStart })}
                  className={`w-12 h-6 rounded-full transition-colors ${settings.autoStart ? 'bg-cyan-500' : 'bg-gray-700'}`}
                >
                  <div className={`w-5 h-5 rounded-full bg-white transition-transform ${settings.autoStart ? 'translate-x-6' : 'translate-x-0.5'}`} />
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
};

const FeatureDetailPanel = ({ feature, onClose }: { feature: Feature; onClose: () => void }) => {
  const [input, setInput] = useState('');
  const [loading, setLoading] = useState(false);

  const handleDemo = () => {
    setLoading(true);
    setTimeout(() => setLoading(false), 1500);
  };

  return (
    <div className="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center p-4">
      <div className="glass-panel rounded-2xl p-6 w-full max-w-xl">
        <div className="flex items-center justify-between mb-6">
          <div className="flex items-center gap-3">
            <div className="p-3 rounded-xl bg-cyan-500/20 text-cyan-400">
              {feature.icon}
            </div>
            <div>
              <h2 className="font-orbitron text-xl text-white">{feature.name}</h2>
              <p className="text-xs text-gray-400">{feature.category}</p>
            </div>
          </div>
          <button onClick={onClose} className="text-gray-400 hover:text-white transition-colors">
            <X className="w-6 h-6" />
          </button>
        </div>

        <p className="text-gray-300 text-sm mb-6">{feature.description}</p>

        <div className="space-y-4">
          <div className="flex gap-2">
            <input 
              type="text" 
              value={input}
              onChange={(e) => setInput(e.target.value)}
              placeholder={`Ask about ${feature.name.toLowerCase()}...`}
              className="flex-1 bg-slate-800 border border-gray-700 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:border-cyan-500 focus:outline-none"
            />
            <button className="p-3 rounded-xl bg-cyan-500 hover:bg-cyan-400 transition-colors">
              <Mic className="w-5 h-5 text-slate-900" />
            </button>
          </div>

          <button 
            onClick={handleDemo}
            disabled={loading}
            className="w-full py-3 rounded-xl bg-gradient-to-r from-cyan-500 to-purple-500 hover:from-cyan-400 hover:to-purple-400 transition-all font-semibold text-white disabled:opacity-50"
          >
            {loading ? (
              <span className="flex items-center justify-center gap-2">
                <RefreshCw className="w-5 h-5 animate-spin" /> Processing...
              </span>
            ) : (
              'Try Demo'
            )}
          </button>
        </div>

        <div className="mt-6 pt-4 border-t border-gray-700">
          <h4 className="text-sm text-gray-400 mb-3">Quick Commands</h4>
          <div className="flex flex-wrap gap-2">
            {['Show status', 'Enable feature', 'View history', 'Reset'].map(cmd => (
              <button key={cmd} className="px-3 py-1.5 text-xs bg-slate-800 rounded-lg text-gray-300 hover:bg-slate-700 transition-colors">
                {cmd}
              </button>
            ))}
          </div>
        </div>
      </div>
    </div>
  );
};

const TimeDisplay = () => {
  const [time, setTime] = useState(new Date());
  
  useEffect(() => {
    const interval = setInterval(() => setTime(new Date()), 1000);
    return () => clearInterval(interval);
  }, []);
  
  return (
    <div className="text-center">
      <div className="font-orbitron text-5xl md:text-6xl font-bold text-cyan-400 neon-text tracking-wider">
        {time.toLocaleTimeString('en-US', { hour12: false })}
      </div>
      <div className="text-gray-400 text-sm mt-2 flex items-center justify-center gap-2">
        <CalendarIcon className="w-4 h-4" />
        {time.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' })}
      </div>
    </div>
  );
};

const AnimatedBackground = () => (
  <div className="fixed inset-0 overflow-hidden pointer-events-none">
    <div className="absolute top-0 left-1/4 w-[600px] h-[600px] bg-cyan-500/5 rounded-full blur-[120px] animate-pulse" />
    <div className="absolute bottom-0 right-1/4 w-[500px] h-[500px] bg-purple-500/5 rounded-full blur-[100px] animate-pulse" style={{ animationDelay: '1s' }} />
    <div className="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-blue-500/3 rounded-full blur-[150px]" />
  </div>
);

// Main App Component
export default function EliteJarvis() {
  const [settings, setSettings] = useState<AppSettings>(readSettings);
  const [isListening, setIsListening] = useState(false);
  const [isMuted, setIsMuted] = useState(false);
  const [isFullscreen, setIsFullscreen] = useState(false);
  const [selectedModel, setSelectedModel] = useState(
    AI_MODELS.find((model) => model.id === readSettings().aiModel) || AI_MODELS[0],
  );
  const [showSettings, setShowSettings] = useState(false);
  const [showFeatures, setShowFeatures] = useState(true);
  const [selectedFeature, setSelectedFeature] = useState<Feature | null>(null);
  
  // Chat state
  const [messages, setMessages] = useState<Message[]>([
    { id: '1', role: 'assistant', content: "Hello. I'm Echo, O'Neill Contractors' AI assistant. How can I help you today?", timestamp: new Date() }
  ]);
  const [inputMessage, setInputMessage] = useState('');
  const [chatLoading, setChatLoading] = useState(false);
  const [chatError, setChatError] = useState<string | null>(null);
  const [speechStatus, setSpeechStatus] = useState<string>('Voice: idle');
  const chatEndRef = useRef<HTMLDivElement>(null);

  // Weather and News state
  const [weather, setWeather] = useState<WeatherData>(EMPTY_WEATHER);
  const [weatherLoading, setWeatherLoading] = useState(false);
  const [weatherError, setWeatherError] = useState<string | null>(null);
  const [news, setNews] = useState<NewsItem[]>([]);
  const [newsLoading, setNewsLoading] = useState(false);
  const [newsError, setNewsError] = useState<string | null>(null);
  const [newsCategory, setNewsCategory] = useState<NewsCategory>(settings.newsCategory);

  // System state
  const [systemStatus, setSystemStatus] = useState<SystemStatus>({
    cpu: null,
    memory: null,
    network: 'online',
    ai: selectedModel.name,
    voice: 'active',
    uptime: '0m',
    disk: 67,
    battery: null,
    limitationMessage: 'Loading system capabilities...',
  });
  const sessionStartRef = useRef(Date.now());

  // Music state
  const [tracks, setTracks] = useState<MusicTrack[]>([]);
  const [currentTrack, setCurrentTrack] = useState(0);
  const [isPlaying, setIsPlaying] = useState(false);
  const [currentTime, setCurrentTime] = useState(0);
  const [musicError, setMusicError] = useState<string | null>(null);
  const audioRef = useRef<HTMLAudioElement | null>(null);

  // Tasks state
  const [tasks, setTasks] = useState<Task[]>([
    { id: '1', title: 'Review AI research papers', completed: false, priority: 'high' },
    { id: '2', title: 'Schedule team meeting', completed: false, priority: 'medium' },
    { id: '3', title: 'Update voice recognition model', completed: true, priority: 'low' },
  ]);

  useEffect(() => {
    localStorage.setItem(SETTINGS_STORAGE_KEY, JSON.stringify(settings));
  }, [settings]);

  useEffect(() => {
    setSelectedModel(AI_MODELS.find((model) => model.id === settings.aiModel) || AI_MODELS[0]);
  }, [settings.aiModel]);

  useEffect(() => {
    setNewsCategory(settings.newsCategory);
  }, [settings.newsCategory]);

  // Scroll to bottom on new messages
  useEffect(() => {
    chatEndRef.current?.scrollIntoView({ behavior: 'smooth' });
  }, [messages]);

  useEffect(() => {
    audioRef.current = new Audio();
    const audio = audioRef.current;

    const handleTimeUpdate = () => {
      setCurrentTime(audio.currentTime);
    };
    const handleTrackEnd = () => {
      if (tracks.length > 0) {
        setCurrentTrack((prev) => (prev + 1) % tracks.length);
      }
    };

    audio.addEventListener('timeupdate', handleTimeUpdate);
    audio.addEventListener('ended', handleTrackEnd);

    return () => {
      audio.pause();
      audio.removeEventListener('timeupdate', handleTimeUpdate);
      audio.removeEventListener('ended', handleTrackEnd);
      tracks.forEach((track) => URL.revokeObjectURL(track.src));
    };
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  useEffect(() => {
    const audio = audioRef.current;
    if (!audio || tracks.length === 0 || !tracks[currentTrack]) return;
    audio.src = tracks[currentTrack].src;
    audio.load();
    setCurrentTime(0);

    const syncMetadata = () => {
      const durationSeconds = Number.isFinite(audio.duration) ? audio.duration : 0;
      setTracks((prev) =>
        prev.map((track, index) =>
          index === currentTrack
            ? { ...track, durationSeconds, duration: formatDuration(durationSeconds) }
            : track,
        ),
      );
    };

    audio.addEventListener('loadedmetadata', syncMetadata);
    if (isPlaying) {
      audio.play().catch(() => {
        setIsPlaying(false);
        setMusicError('Unable to autoplay. Press play to start audio.');
      });
    }

    return () => {
      audio.removeEventListener('loadedmetadata', syncMetadata);
    };
  }, [currentTrack, tracks, isPlaying]);

  useEffect(() => {
    const audio = audioRef.current;
    if (!audio) return;
    if (isPlaying) {
      audio.play().catch(() => {
        setIsPlaying(false);
        setMusicError('Unable to play selected file.');
      });
    } else {
      audio.pause();
    }
  }, [isPlaying]);

  useEffect(() => {
    const updateNetwork = () => {
      setSystemStatus((prev) => ({ ...prev, network: navigator.onLine ? 'online' : 'offline' }));
    };
    updateNetwork();
    window.addEventListener('online', updateNetwork);
    window.addEventListener('offline', updateNetwork);
    return () => {
      window.removeEventListener('online', updateNetwork);
      window.removeEventListener('offline', updateNetwork);
    };
  }, []);

  useEffect(() => {
    let mounted = true;
    const isElectron = typeof window !== 'undefined' && typeof window.electronAPI?.getSystemStats === 'function';

    const updateUptime = () => {
      setSystemStatus((prev) => ({ ...prev, uptime: formatUptime(sessionStartRef.current) }));
    };

    updateUptime();
    const uptimeTimer = setInterval(updateUptime, 1000);

    if (isElectron) {
      const pollSystemStats = async () => {
        try {
          const stats = await window.electronAPI?.getSystemStats?.();
          if (!mounted || !stats) return;
          setSystemStatus((prev) => ({
            ...prev,
            cpu: Math.round(stats.cpu),
            memory: Math.round(stats.memory),
            disk: stats.disk ? Math.round(stats.disk) : prev.disk,
            limitationMessage: undefined,
          }));
        } catch {
          if (!mounted) return;
          setSystemStatus((prev) => ({
            ...prev,
            cpu: null,
            memory: null,
            limitationMessage: 'Unable to read Electron system stats. Check preload bridge.',
          }));
        }
      };
      pollSystemStats();
      const interval = setInterval(pollSystemStats, 5000);
      return () => {
        mounted = false;
        clearInterval(interval);
        clearInterval(uptimeTimer);
      };
    }

    setSystemStatus((prev) => ({
      ...prev,
      cpu: null,
      memory: null,
      limitationMessage: 'CPU and memory metrics are unavailable in browser-only mode.',
    }));

    if ('getBattery' in navigator) {
      (navigator as Navigator & { getBattery: () => Promise<BatteryManager> })
        .getBattery()
        .then((battery) => {
          const syncBattery = () => {
            if (!mounted) return;
            setSystemStatus((prev) => ({ ...prev, battery: Math.round(battery.level * 100) }));
          };
          syncBattery();
          battery.addEventListener('levelchange', syncBattery);
          battery.addEventListener('chargingchange', syncBattery);
        })
        .catch(() => {
          setSystemStatus((prev) => ({ ...prev, battery: null }));
        });
    } else {
      setSystemStatus((prev) => ({ ...prev, battery: null }));
    }

    return () => {
      mounted = false;
      clearInterval(uptimeTimer);
    };
  }, []);

  useEffect(() => {
    setSystemStatus((prev) => ({ ...prev, ai: selectedModel.name, voice: settings.voiceEnabled ? 'active' : 'inactive' }));
  }, [selectedModel.name, settings.voiceEnabled]);

  useEffect(() => {
    if (isMuted || !settings.voiceEnabled) {
      stopSpeech();
    }
  }, [isMuted, settings.voiceEnabled]);

  const speakAssistantReply = async (text: string) => {
    const result: SpeakResult = await speakText(text, {
      enabled: settings.voiceEnabled && !isMuted,
      provider: settings.ttsProvider,
      elevenLabsApiKey: settings.elevenLabsApiKey,
      elevenLabsVoiceId: settings.elevenLabsVoiceId,
      preferredBrowserVoice: settings.preferredBrowserVoice,
    });
    if (result.ok) {
      setSpeechStatus(`Voice: ${result.providerUsed === 'elevenlabs' ? 'ElevenLabs' : 'Browser'}`);
    } else {
      setSpeechStatus(`Voice: ${result.error ?? 'unavailable'}`);
    }
    if (!result.ok && settings.voiceEnabled && !isMuted) {
      setChatError(result.error ?? 'Speech output failed.');
    }
  };

  const fetchWeather = async () => {
    setWeatherLoading(true);
    setWeatherError(null);
    try {
      const data = await fetchWeatherData(settings);
      setWeather(data);
    } catch (error) {
      const message = error instanceof Error ? error.message : 'Unable to load weather.';
      setWeatherError(message);
    } finally {
      setWeatherLoading(false);
    }
  };

  const fetchNews = async (category: NewsCategory) => {
    setNewsLoading(true);
    setNewsError(null);
    try {
      const data = await fetchNewsData(category, settings);
      setNews(data);
    } catch (error) {
      const message = error instanceof Error ? error.message : 'Unable to load news.';
      setNewsError(message);
      setNews([]);
    } finally {
      setNewsLoading(false);
    }
  };

  useEffect(() => {
    fetchWeather();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [settings.weatherApiKey, settings.weatherLocation]);

  useEffect(() => {
    fetchNews(newsCategory);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [settings.newsApiKey, newsCategory]);

  const handleSendMessage = async () => {
    if (!inputMessage.trim()) return;
    
    const userMessage: Message = {
      id: Date.now().toString(),
      role: 'user',
      content: inputMessage,
      timestamp: new Date(),
    };
    
    setMessages(prev => [...prev, userMessage]);
    setInputMessage('');
    setChatLoading(true);
    setChatError(null);

    try {
      const conversation = [...messages, userMessage];
      const responseText = await getModelResponse(
        selectedModel.id,
        conversation.map((message) => ({ role: message.role, content: message.content })),
        settings,
      );
      const aiResponse: Message = {
        id: `${Date.now()}-assistant`,
        role: 'assistant',
        content: responseText,
        timestamp: new Date(),
      };
      setMessages((prev) => [...prev, aiResponse]);
      await speakAssistantReply(responseText);
    } catch (error) {
      const message = error instanceof Error ? error.message : 'AI request failed.';
      setChatError(message);
      setMessages((prev) => [
        ...prev,
        {
          id: `${Date.now()}-assistant-error`,
          role: 'assistant',
          content: `I couldn't reach ${selectedModel.name}: ${message}`,
          timestamp: new Date(),
        },
      ]);
    } finally {
      setChatLoading(false);
    }
  };

  const toggleListening = () => {
    setIsListening((prev) => !prev);
    if (!isListening) {
      setTimeout(() => {
        const voiceMessage: Message = {
          id: Date.now().toString(),
          role: 'assistant',
          content: 'I heard you say "What can I help you with?" - How may I assist you?',
          timestamp: new Date(),
          type: 'voice'
        };
        setMessages((prev) => [...prev, voiceMessage]);
        void speakAssistantReply(voiceMessage.content);
      }, 2000);
    }
  };

  const toggleFullscreen = () => {
    if (!document.fullscreenElement) {
      document.documentElement.requestFullscreen();
      setIsFullscreen(true);
    } else {
      document.exitFullscreen();
      setIsFullscreen(false);
    }
  };

  const handleKeyPress = (e: React.KeyboardEvent) => {
    if (e.key === 'Enter') handleSendMessage();
  };

  const toggleTask = (id: string) => {
    setTasks(prev => prev.map(t => t.id === id ? { ...t, completed: !t.completed } : t));
  };

  const deleteTask = (id: string) => {
    setTasks(prev => prev.filter(t => t.id !== id));
  };

  const addTask = () => {
    const newTask: Task = {
      id: Date.now().toString(),
      title: 'New task',
      completed: false,
      priority: 'medium'
    };
    setTasks(prev => [...prev, newTask]);
  };

  const handleLoadMusicFiles = async () => {
    setMusicError(null);
    try {
      let files: File[] = [];
      if ('showOpenFilePicker' in window) {
        const handles = await (window as any).showOpenFilePicker({
          multiple: true,
          types: [{ description: 'Audio Files', accept: { 'audio/*': ['.mp3', '.wav', '.ogg', '.m4a', '.flac'] } }],
        });
        files = await Promise.all(handles.map((handle: any) => handle.getFile()));
      } else {
        files = await new Promise<File[]>((resolve) => {
          const input = document.createElement('input');
          input.type = 'file';
          input.accept = 'audio/*';
          input.multiple = true;
          input.onchange = () => resolve(Array.from(input.files ?? []));
          input.click();
        });
      }

      if (files.length === 0) return;

      setTracks((previous) => {
        previous.forEach((track) => URL.revokeObjectURL(track.src));
        return mapFilesToTracks(files);
      });
      setCurrentTrack(0);
      setIsPlaying(false);
      setCurrentTime(0);
    } catch (error) {
      const message = error instanceof Error ? error.message : 'Unable to load audio files.';
      setMusicError(message);
    }
  };

  const handlePlayPause = () => {
    if (tracks.length === 0) {
      setMusicError('Load local audio files to enable playback.');
      return;
    }
    setMusicError(null);
    setIsPlaying((prev) => !prev);
  };

  const handleNextTrack = () => {
    if (tracks.length === 0) return;
    setCurrentTrack((prev) => (prev + 1) % tracks.length);
  };

  const handlePrevTrack = () => {
    if (tracks.length === 0) return;
    setCurrentTrack((prev) => (prev - 1 + tracks.length) % tracks.length);
  };

  return (
    <div className="min-h-screen bg-slate-950 grid-bg hex-pattern">
      <AnimatedBackground />

      <div className="relative z-10 p-4 md:p-6 lg:p-8 max-w-[1920px] mx-auto">
        {/* Header */}
        <header className="flex items-center justify-between mb-6">
          <div className="flex items-center gap-4">
            <div className="relative group">
              <div className="w-14 h-14 md:w-16 md:h-16 rounded-2xl bg-gradient-to-br from-cyan-400 to-cyan-300 neon-glow flex items-center justify-center transition-transform group-hover:scale-110">
                <Brain className="w-7 h-7 md:w-8 md:h-8 text-slate-900" />
              </div>
              <div className="absolute -bottom-1 -right-1 w-4 h-4 bg-green-400 rounded-full pulse-ring" />
              <div className="absolute -top-1 -left-1 w-4 h-4 bg-cyan-400 rounded-full opacity-50 animate-ping" />
            </div>
            <div>
              <h1 className="font-orbitron text-2xl md:text-3xl font-bold text-white">
                <span className="text-cyan-400">ECHO</span>
              </h1>
              <p className="text-gray-400 text-sm flex items-center gap-2">
                <span className="w-2 h-2 bg-green-400 rounded-full animate-pulse" />
                O'NEILL CONTRACTORS | PRECONSTRUCTION AI
              </p>
            </div>
          </div>
          
          <div className="flex items-center gap-2 md:gap-4">
            <button
              onClick={() => setShowFeatures(!showFeatures)}
              className={`p-2 rounded-lg transition-all ${showFeatures ? 'bg-cyan-500/20 text-cyan-400' : 'text-gray-400 hover:text-white hover:bg-white/5'}`}
              title="Toggle Features"
            >
              <Command className="w-5 h-5" />
            </button>
            
            <button
              onClick={() => setShowSettings(true)}
              className="p-2 rounded-lg text-gray-400 hover:text-white hover:bg-white/5 transition-all"
              title="Settings"
            >
              <Settings className="w-5 h-5" />
            </button>
            
            <button
              onClick={toggleFullscreen}
              className="p-2 rounded-lg text-gray-400 hover:text-white hover:bg-white/5 transition-all hidden md:block"
              title="Fullscreen"
            >
              {isFullscreen ? <Minimize2 className="w-5 h-5" /> : <Maximize2 className="w-5 h-5" />}
            </button>
          </div>
        </header>

        {/* Holographic Core */}
        <div className="flex justify-center mb-8">
          <div className="relative w-52 h-52 flex items-center justify-center">
            <div className="absolute w-52 h-52 rounded-full bg-gradient-to-br from-cyan-400/10 to-purple-500/10 border border-cyan-400/30 animate-[spin_25s_linear_infinite]"></div>
            <div className="absolute w-44 h-44 rounded-full bg-gradient-to-br from-purple-400/10 to-cyan-400/10 border border-purple-400/30 animate-[spin_18s_linear_infinite_reverse]"></div>
            
            {/* Central Jarvis Orb */}
            <div 
              onClick={toggleListening}
              className={`relative w-36 h-36 rounded-full flex items-center justify-center cursor-pointer transition-all duration-300 neon-glow ${isListening ? 'scale-110 bg-cyan-400/20' : 'bg-slate-900/80'}`}
            >
              <div className="absolute inset-0 rounded-full border-4 border-cyan-400/40 animate-ping"></div>
              <div className="absolute inset-2 rounded-full border border-white/30"></div>
              
              <div className="relative z-10 flex flex-col items-center">
                <Brain className={`w-16 h-16 transition-all ${isListening ? 'text-cyan-300 scale-110' : 'text-cyan-400'}`} />
                <div className="text-[10px] font-orbitron tracking-[3px] text-cyan-400/80 mt-2">ECHO</div>
              </div>
              
              {isListening && <VoiceWave active={isListening} />}
            </div>
            
            {/* Orbiting rings */}
            <div className="absolute w-[280px] h-[280px] border border-cyan-400/20 rounded-full animate-[spin_30s_linear_infinite]"></div>
            <div className="absolute w-[310px] h-[310px] border border-purple-400/10 rounded-full animate-[spin_45s_linear_infinite_reverse]"></div>
          </div>
        </div>

        {/* Main Content Grid */}
        <div className="grid grid-cols-1 lg:grid-cols-12 gap-6">
          {/* Left Sidebar - Features & Status */}
          <div className={`lg:col-span-3 space-y-4 transition-all ${showFeatures ? 'opacity-100' : 'opacity-50 pointer-events-none'}`}>
            <TimeDisplay />
            
            <SystemMonitor status={systemStatus} />
            
            <WeatherPanel weather={weather} loading={weatherLoading} error={weatherError} onRefresh={fetchWeather} />
            
            <NewsPanel
              news={news}
              loading={newsLoading}
              error={newsError}
              category={newsCategory}
              onCategoryChange={(category) => {
                setNewsCategory(category);
                setSettings((prev) => ({ ...prev, newsCategory: category }));
              }}
              onRefresh={() => fetchNews(newsCategory)}
            />
            
            <MusicPlayer 
              tracks={tracks}
              currentTrack={currentTrack}
              isPlaying={isPlaying}
              currentTime={currentTime}
              onPlayPause={handlePlayPause}
              onNext={handleNextTrack}
              onPrev={handlePrevTrack}
              onLoadFiles={handleLoadMusicFiles}
              error={musicError}
            />

            <TodoPanel 
              tasks={tasks}
              onToggle={toggleTask}
              onDelete={deleteTask}
              onAdd={addTask}
            />
          </div>

          {/* Main Area - Chat */}
          <div className="lg:col-span-6 flex flex-col">
            {/* AI Model Selector */}
            <div className="glass-panel rounded-xl p-3 mb-4">
              <div className="flex items-center justify-between">
                <div className="flex items-center gap-2">
                  <Bot className="w-5 h-5 text-cyan-400" />
                  <span className="text-sm text-gray-400">AI Model:</span>
                  <select 
                    value={selectedModel.id}
                    onChange={(e) => {
                      const model = AI_MODELS.find((m) => m.id === e.target.value) || AI_MODELS[0];
                      setSelectedModel(model);
                      setSettings((prev) => ({ ...prev, aiModel: model.id }));
                    }}
                    className="bg-transparent border-none text-white font-semibold focus:outline-none cursor-pointer"
                  >
                    {AI_MODELS.map(m => (
                      <option key={m.id} value={m.id} className="bg-slate-900">{m.name} ({m.provider})</option>
                    ))}
                  </select>
                </div>
                <div className="flex items-center gap-2">
                  <VoiceWave active={isListening} />
                  <button
                    onClick={toggleListening}
                    className={`p-2 rounded-lg transition-all ${isListening ? 'bg-red-500/20 text-red-400 animate-pulse' : 'text-gray-400 hover:text-white'}`}
                  >
                    {isListening ? <MicOff className="w-5 h-5" /> : <Mic className="w-5 h-5" />}
                  </button>
                  <button
                    onClick={() => {
                      setIsMuted((prev) => {
                        const next = !prev;
                        if (next) stopSpeech();
                        return next;
                      });
                    }}
                    className="p-2 rounded-lg text-gray-400 hover:text-white transition-all"
                  >
                    {isMuted ? <VolumeX className="w-5 h-5" /> : <Volume2 className="w-5 h-5" />}
                  </button>
                </div>
              </div>
            </div>

            {/* Chat Messages */}
            <div className="glass-panel rounded-2xl flex-1 p-4 md:p-6 overflow-hidden flex flex-col">
              <div className="flex-1 overflow-y-auto space-y-4 mb-4 scrollbar-thin">
                {messages.map((message) => (
                  <ChatMessage key={message.id} message={message} />
                ))}
                <div ref={chatEndRef} />
              </div>

              {/* Input Area */}
              <div className="flex gap-3">
                <div className="flex-1 relative">
                  <input 
                    type="text"
                    value={inputMessage}
                    onChange={(e) => setInputMessage(e.target.value)}
                    onKeyPress={handleKeyPress}
                    placeholder="Ask me anything..."
                    className="w-full bg-slate-900/50 border border-gray-700 rounded-xl px-4 py-3 pr-12 text-white placeholder-gray-500 focus:border-cyan-500 focus:outline-none focus:ring-2 focus:ring-cyan-500/20 transition-all"
                  />
                  <button className="absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 hover:text-cyan-400 transition-colors">
                    <Mic className="w-5 h-5" />
                  </button>
                </div>
                <button 
                  onClick={handleSendMessage}
                  disabled={!inputMessage.trim() || chatLoading}
                  className="px-6 rounded-xl bg-gradient-to-r from-cyan-500 to-purple-500 hover:from-cyan-400 hover:to-purple-400 transition-all disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-2"
                >
                  {chatLoading ? <RefreshCw className="w-5 h-5 text-white animate-spin" /> : <Send className="w-5 h-5 text-white" />}
                </button>
              </div>
              {chatError && <p className="text-xs text-red-400 mt-3">{chatError}</p>}
              <p className="text-[11px] text-gray-500 mt-1">{speechStatus}</p>
            </div>
          </div>

          {/* Right Sidebar - Feature Cards */}
          <div className={`lg:col-span-3 space-y-4 transition-all ${showFeatures ? 'opacity-100' : 'opacity-50 pointer-events-none'}`}>
            <div className="glass-panel rounded-xl p-4">
              <div className="flex items-center justify-between mb-4">
                <h3 className="font-orbitron text-cyan-400 text-sm font-semibold flex items-center gap-2">
                  <Sparkles className="w-4 h-4" />
                  FEATURES
                </h3>
                <span className="text-xs text-gray-500">{ALL_FEATURES.length} available</span>
              </div>
              
              <div className="space-y-2 max-h-[calc(100vh-400px)] overflow-y-auto scrollbar-thin pr-2">
                {ALL_FEATURES.map((feature) => (
                  <FeatureCard 
                    key={feature.id} 
                    feature={feature} 
                    onClick={() => setSelectedFeature(feature)}
                    expanded={selectedFeature?.id === feature.id}
                  />
                ))}
              </div>
            </div>

            {/* Quick Stats */}
            <div className="glass-panel rounded-xl p-4">
              <h3 className="font-orbitron text-cyan-400 text-sm font-semibold mb-3">STATISTICS</h3>
              <div className="grid grid-cols-2 gap-3">
                <div className="text-center p-3 bg-slate-900/50 rounded-lg">
                  <div className="text-2xl font-bold text-white">{messages.length}</div>
                  <div className="text-xs text-gray-500">Messages</div>
                </div>
                <div className="text-center p-3 bg-slate-900/50 rounded-lg">
                  <div className="text-2xl font-bold text-white">{tasks.filter(t => !t.completed).length}</div>
                  <div className="text-xs text-gray-500">Pending Tasks</div>
                </div>
                <div className="text-center p-3 bg-slate-900/50 rounded-lg">
                  <div className="text-2xl font-bold text-white">{ALL_FEATURES.length}</div>
                  <div className="text-xs text-gray-500">Features</div>
                </div>
                <div className="text-center p-3 bg-slate-900/50 rounded-lg">
                  <div className="text-2xl font-bold text-green-400">Online</div>
                  <div className="text-xs text-gray-500">Status</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      {/* Settings Modal */}
      {showSettings && (
        <SettingsPanel
          onClose={() => setShowSettings(false)}
          settings={settings}
          onUpdate={(update) => setSettings((prev) => ({ ...prev, ...update }))}
        />
      )}

      {/* Feature Detail Modal */}
      {selectedFeature && (
        <FeatureDetailPanel 
          feature={selectedFeature} 
          onClose={() => setSelectedFeature(null)} 
        />
      )}
    </div>
  );
}
